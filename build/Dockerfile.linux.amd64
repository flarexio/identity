FROM node:24-alpine3.24 AS web
WORKDIR /src/web
COPY web/package.json web/package-lock.json ./
RUN npm ci --no-audit --no-fund
COPY web/ ./
RUN npm run build

FROM golang:1.27-alpine3.24 AS builder
RUN apk add --no-cache git gcc musl-dev
WORKDIR /src
COPY go.mod go.sum ./
RUN go mod download
COPY . .
RUN CGO_ENABLED=1 go build -trimpath -o /identity ./cmd/identity

# No config is baked in: mount config.yaml (with your own keys) into
# $IDENTITY_PATH. The service refuses to start without one.
FROM alpine:3.24
RUN adduser -D -H -u 10001 identity \
 && mkdir -p /var/lib/identity \
 && chown identity:identity /var/lib/identity
COPY --from=builder /identity /bin/identity
COPY --from=builder /src/permissions.json /var/lib/identity/
COPY --from=web /src/web/dist /var/lib/identity/web
ENV IDENTITY_PATH=/var/lib/identity
WORKDIR /var/lib/identity
USER identity
EXPOSE 8080 8443
ENTRYPOINT ["/bin/identity"]
